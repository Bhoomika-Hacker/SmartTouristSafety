@model GeoFenceZone
@{
    ViewData["Title"] = "New Geo-Fence Zone";
}

<h2 class="section-title">Define New Geo-Fence Zone</h2>

<div class="table-card p-4" style="max-width: 640px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label">Zone Name</label>
                <input asp-for="Name" class="form-control" required />
            </div>
            <div class="col-12">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-md-6">
                <label class="form-label">Latitude</label>
                <input asp-for="Latitude" type="number" step="0.000001" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Longitude</label>
                <input asp-for="Longitude" type="number" step="0.000001" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Radius (meters)</label>
                <input asp-for="RadiusMeters" type="number" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Risk Level</label>
                <select asp-for="RiskLevel" class="form-select" asp-items="Html.GetEnumSelectList<RiskLevel>()"></select>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn text-white" style="background-color: var(--sts-navy)">Create Zone</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
