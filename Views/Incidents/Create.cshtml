@model Incident
@{
    ViewData["Title"] = "Report Incident";
    var tourists = ViewBag.Tourists as List<Tourist> ?? new List<Tourist>();
}

<h2 class="section-title">Report an Incident</h2>

<div class="table-card p-4" style="max-width: 640px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label">Tourist</label>
                <select asp-for="TouristId" class="form-select" required>
                    <option value="">-- Select tourist --</option>
                    @foreach (var t in tourists)
                    {
                        <option value="@t.Id">@t.FullName (@t.Nationality)</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Incident Type</label>
                <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<IncidentType>()"></select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Severity</label>
                <select asp-for="Severity" class="form-select" asp-items="Html.GetEnumSelectList<IncidentSeverity>()"></select>
            </div>
            <div class="col-12">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="col-md-6">
                <label class="form-label">Latitude (optional)</label>
                <input asp-for="Latitude" type="number" step="0.000001" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Longitude (optional)</label>
                <input asp-for="Longitude" type="number" step="0.000001" class="form-control" />
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn text-white" style="background-color: var(--sts-navy)">Submit Incident</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
