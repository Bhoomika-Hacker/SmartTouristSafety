<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Smart Tourist Safety</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script>
        // Set the theme before first paint so there's no flash. "auto" (the default)
        // reflects the *real* local time of day; the visitor can still override it
        // with the nav toggle for the current tab session.
        (function () {
            var saved = sessionStorage.getItem('sts-theme-override');
            var hour = new Date().getHours();
            var isNight = hour >= 19 || hour < 6;
            var theme = saved || (isNight ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-shield-check"></i> Smart Tourist Safety
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    @if (User.IsInRole("Tourist"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="TouristPortal" asp-action="Index"><i class="bi bi-shield-check"></i> My Safety Dashboard</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Tourists" asp-action="Index"><i class="bi bi-people"></i> Tourists</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Zones" asp-action="Index"><i class="bi bi-geo-alt"></i> Geo-Fence Zones</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Incidents" asp-action="Index"><i class="bi bi-exclamation-triangle"></i> Incidents</a></li>
                    }
                </ul>
                <ul class="navbar-nav align-items-lg-center">
                    <li class="nav-item me-3">
                        <span id="navClock" class="nav-clock"><i class="bi bi-brightness-high-fill" id="navClockIcon"></i> <span id="navClockText">--:--:--</span></span>
                    </li>
                    <li class="nav-item me-3 d-flex align-items-center">
                        <button id="themeToggle" class="theme-toggle" type="button" title="Toggle day / night theme" aria-label="Toggle theme">
                            <span class="stars">
                                <span style="top:4px;left:8px;"></span>
                                <span style="top:14px;left:16px;"></span>
                                <span style="top:8px;left:24px;"></span>
                                <span style="top:18px;left:30px;"></span>
                            </span>
                            <span class="knob"><i class="bi bi-sun-fill" id="knobIcon" style="font-size:11px;color:#c98a00;"></i></span>
                        </button>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item d-flex align-items-center me-3 text-light">
                            <i class="bi bi-person-circle me-1"></i> @User.Identity!.Name
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Login</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container-fluid py-4 px-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="text-center text-muted py-3 small">
        Smart Tourist Safety Monitoring &amp; Incident Response System &mdash; AI &middot; Geo-Fencing &middot; Blockchain Digital ID
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // ---------- Day / Night theme ----------
        function applyKnobIcon(theme) {
            const icon = document.getElementById('knobIcon');
            const navIcon = document.getElementById('navClockIcon');
            if (icon) icon.className = theme === 'dark' ? 'bi bi-moon-stars-fill' : 'bi bi-sun-fill';
            if (icon) icon.style.color = theme === 'dark' ? '#5b6b8c' : '#c98a00';
            if (navIcon) navIcon.className = theme === 'dark' ? 'bi bi-moon-stars-fill' : 'bi bi-brightness-high-fill';
        }
        applyKnobIcon(document.documentElement.getAttribute('data-theme'));

        document.getElementById('themeToggle').addEventListener('click', function () {
            const current = document.documentElement.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            sessionStorage.setItem('sts-theme-override', next); // manual override for this tab/session only
            applyKnobIcon(next);
        });

        // ---------- Live clock, and auto theme drift across real day/night if the user hasn't overridden it ----------
        function tickClock() {
            const now = new Date();
            const el = document.getElementById('navClockText');
            if (el) {
                el.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            }
            if (!sessionStorage.getItem('sts-theme-override')) {
                const hour = now.getHours();
                const shouldBeNight = hour >= 19 || hour < 6;
                const wantTheme = shouldBeNight ? 'dark' : 'light';
                if (document.documentElement.getAttribute('data-theme') !== wantTheme) {
                    document.documentElement.setAttribute('data-theme', wantTheme);
                    applyKnobIcon(wantTheme);
                }
            }
        }
        tickClock();
        setInterval(tickClock, 1000);

        // ---------- Scroll-reveal interactivity applied to every page automatically ----------
        document.addEventListener('DOMContentLoaded', function () {
            const targets = document.querySelectorAll('.table-card, .card-stat, .login-wrapper .card');
            targets.forEach(function (el, i) {
                el.classList.add('reveal');
                el.style.transitionDelay = Math.min(i * 60, 300) + 'ms';
            });
            if ('IntersectionObserver' in window) {
                const io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-visible');
                            io.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.08 });
                targets.forEach(function (el) { io.observe(el); });
            } else {
                targets.forEach(function (el) { el.classList.add('is-visible'); });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
